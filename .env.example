# ==============================================================================
# Auralis Web - Firebase & Google Authentication Configuration
# ==============================================================================
# To enable Google Sign-In on the /admin panel:
# 1. Open the Firebase Console (https://console.firebase.google.com/)
# 2. Go to Project Settings -> General -> Your Apps -> Web App (</>) and copy firebaseConfig.
# 3. Enable Authentication -> Sign-in method -> Google Provider.
# 4. Paste your configuration keys below:

# Google Identity Services Client ID (Get from Google Cloud Console or Firebase Authentication):
VITE_GOOGLE_CLIENT_ID=

# Firebase Web App Config (Alternative if using Firebase):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
